{
  "name": "ai-integration-tour",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.106",
    "ai": "^7.0.159",
    "expo": "^58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:infrastructure": "jest --runInBand --runTestsByPath __tests__/infrastructure/projectInfrastructure.test.js && npm run test:provider-contract",
    "test:provider-contract": "node scripts/check-provider-payload.mjs",
    "check-progress": "node scripts/check-progress.js",
    "check-progress:report": "node scripts/check-progress.js --report-only",
    "lint": "expo lint",
    "verify": "npm run check-progress && npm run lint && npm test && npm run test:provider-contract"
  },
  "private": true,
  "devDependencies": {
    "@babel/parser": "7.26.10",
    "@babel/traverse": "7.26.10",
    "@testing-library/react-native": "13.3.3",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "react-test-renderer": "19.3.0"
  }
}
